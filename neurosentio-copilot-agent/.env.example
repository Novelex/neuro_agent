# NeuroSentio Copilot Agent — Environment Variables
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=neurosentio-copilot-agent
APP_VERSION=0.2.0
DEBUG=false

# Database
# SQLite for local development (default)
DATABASE_URL=sqlite:///./neurosentio.db

# To switch to PostgreSQL / Supabase later, replace with:
# DATABASE_URL=postgresql://user:password@host:5432/neurosentio

# Local development user identity
DEFAULT_USER_ID=demo-user
USER_ID_HEADER=X-User-ID

# ── LLM Configuration (Day 3) ────────────────────────────────────────
# Which LLM provider to use: mock | anthropic | openai
# Default is mock — the app runs with NO API key required.
LLM_PROVIDER=mock

# Anthropic (only needed if LLM_PROVIDER=anthropic)
# Install: pip install anthropic
ANTHROPIC_API_KEY=

# OpenAI (only needed if LLM_PROVIDER=openai)
# Install: pip install openai
OPENAI_API_KEY=

# Model name — left empty, each provider picks a sensible default
LLM_MODEL=

# Timeout for LLM requests in seconds
LLM_TIMEOUT_SECONDS=30
