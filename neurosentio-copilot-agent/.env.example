# ──────────────────────────────────────────────────────────────────────
# NeuroSentio Copilot Agent — Environment Configuration
# ──────────────────────────────────────────────────────────────────────

# ── App Environment ───────────────────────────────────────────────────
# "development" = local dev, X-User-ID allowed, SQLite default
# "production"  = requires JWT auth, rejects X-User-ID
# "testing"     = used by test runners
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./neurosentio.db

# Postgres / Supabase (production):
# Use the "direct connection" URL for server-side apps (not the pooler URL).
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Postgres URL for running tests against Postgres (optional):
# POSTGRES_TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/neurosentio_test

# ── Auth: Development Fallback ────────────────────────────────────────
# Allow X-User-ID header in development mode (NEVER enable in production!)
ALLOW_DEV_USER_HEADER=true

# Auth requirement toggle (set to true for production)
AUTH_REQUIRED=false

# ── Auth: Supabase JWT ────────────────────────────────────────────────
# Supabase project URL (optional, for future direct API integration)
# SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase JWT Secret (find in Supabase Dashboard → Settings → API → JWT Secret)
# Used for HS256 token verification — sufficient for initial integration.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase JWKS URL (for asymmetric key verification — RS256/ES256)
# Recommended for newer Supabase projects. Not yet implemented; documented for future.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/.well-known/jwks.json

# JWT audience claim (Supabase default is "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# ── LLM Configuration ────────────────────────────────────────────────
# Provider: "mock" (default, no API key), "anthropic", "openai", or "openrouter"
LLM_PROVIDER=openrouter

# OpenRouter (200+ models via a single API key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
# OPENAI_API_KEY=sk-...

# ── LLM Rate Limits ──────────────────────────────────────────────────
LLM_DAILY_USER_LIMIT=50
LLM_MONTHLY_USER_LIMIT=1000

# ── LLM Real Provider & Quality Evaluation ────────────────────────────
LLM_ENABLE_REAL_PROVIDER_TESTS=false
LLM_ENABLE_PROMPT_EVAL=false

# ── Logging/Privacy (default false) ────────────────────────────────────
LLM_LOG_PROMPTS=false
LLM_LOG_RESPONSES=false

# ── Local Postgres Docker Configuration ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neurosentio_test
POSTGRES_USER=neurosentio
POSTGRES_PASSWORD=neurosentio
POSTGRES_DATABASE_URL=postgresql+psycopg://neurosentio:neurosentio@localhost:5432/neurosentio_test

