{"openapi": "3.1.0", "info": {"title": "NeuroSentio Copilot Agent (AI Proxy)", "description": "The standalone backend brain of NeuroSentio Daily Copilot. Acts as a proxy for OpenRouter LLM requests.", "version": "0.5.0"}, "paths": {"/health": {"get": {"tags": ["Health"], "summary": "Health check", "description": "Returns service status and verifies database connectivity.\nReturns 200 if healthy, includes db_status for monitoring.", "operationId": "health_check_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/tasks/{task_id}/decompose": {"post": {"tags": ["Decomposition"], "summary": "Decompose a task into micro-actions", "description": "Breaks a task into tiny, neurodivergent-friendly micro-actions.\n\n- If micro-actions already exist for this task, returns them without regenerating\n  (unless force_regenerate=true).\n- If current_energy < 30, switches to recovery mode (fewer, smaller actions).\n- Uses mock LLM by default \u2014 no API key required.\n- Falls back to rule-based decomposition if LLM fails.", "operationId": "decompose_task_endpoint_tasks__task_id__decompose_post", "parameters": [{"name": "task_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Task Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskDecomposeRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskDecomposeResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/tasks/{task_id}/micro-actions": {"get": {"tags": ["Decomposition"], "summary": "Get all micro-actions for a task", "description": "Returns all micro-actions for the given task, ordered by sort_order.\nScoped to the current user \u2014 another user's tasks return an empty list.", "operationId": "get_task_micro_actions_tasks__task_id__micro_actions_get", "parameters": [{"name": "task_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Task Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/MicroAction"}, "title": "Response Get Task Micro Actions Tasks  Task Id  Micro Actions Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/micro-actions/{micro_action_id}/status": {"patch": {"tags": ["MicroActions"], "summary": "Update micro-action status", "description": "Update the status of a single micro-action.\nAllowed values: open, done, snoozed, skipped, deferred.", "operationId": "update_micro_action_status_micro_actions__micro_action_id__status_patch", "parameters": [{"name": "micro_action_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Micro Action Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MicroActionStatusUpdate"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MicroAction"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/micro-actions/{micro_action_id}/make-smaller": {"post": {"tags": ["MicroActions"], "summary": "Split a micro-action into smaller actions", "description": "This action still feels too big.\n\nSplits it into 1\u20133 smaller actions inserted after the original in sort order.\nThe original action is NOT deleted \u2014 it stays in the list for reference.\nIf current_energy < 30, generates a lighter version (recovery mode).", "operationId": "make_action_smaller_micro_actions__micro_action_id__make_smaller_post", "parameters": [{"name": "micro_action_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Micro Action Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MakeSmallerRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MakeSmallerResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/copilot/morning-plan": {"post": {"tags": ["MorningPlan"], "summary": "Generate today's morning plan", "description": "Generates a neurodivergent-friendly morning plan.\n\n- Selects micro-actions from open tasks (auto-decomposes if auto_decompose=true).\n- Switches to recovery mode when energy < 30 or overload risk >= 60.\n- Saves plan to DB and links selected micro-actions to plan_id.\n- Adds transition suggestions (starting_work, making_call, recovery_break).\n- Returns existing plan without regenerating unless force_regenerate=true.", "operationId": "create_morning_plan_copilot_morning_plan_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/MorningPlanRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MorningPlan"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/copilot/morning-plan/today": {"get": {"tags": ["MorningPlan"], "summary": "Get today's morning plan", "description": "Returns today's morning plan if one has been generated.\nReturns 404 if no plan exists for today \u2014 call POST /copilot/morning-plan to create one.", "operationId": "get_today_morning_plan_copilot_morning_plan_today_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MorningPlan"}}}}}}}, "/transitions/generate": {"post": {"tags": ["Transitions"], "summary": "Generate a transition script", "description": "Generates a gentle, neurodivergent-friendly transition script.\n\nSupported types: leaving_house, starting_work, making_call, ending_day,\ncontext_switch, recovery_break, custom.\n\nIf current_energy < 30, generates a shorter recovery version (\u2264 3 steps).", "operationId": "generate_transition_transitions_generate_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransitionScriptGenerateRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransitionScriptGenerateResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reply/draft": {"post": {"tags": ["ReplyDrafter"], "summary": "Generate reply draft options", "description": "Paste any message text and receive 3 neurodivergent-friendly reply options:\nshort, warm, and detailed. A boundary option is included when:\n- current_energy < 40\n- user_intent includes decline/delay/boundary/not available\n- include_boundary_option=true (default)\n\n**This endpoint NEVER sends messages.**\nAll drafts are stored locally. No external connections.", "operationId": "create_reply_draft_reply_draft_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReplyDraftRequest"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReplyDraft"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/copilot/replan": {"post": {"tags": ["Adaptive Replanner"], "summary": "Trigger an adaptive replan", "description": "Adjusts the remaining day plan based on a trigger.\n\nTriggers:\n- low_energy: reduces actions, defers high-energy tasks, adds recovery block\n- skipped_actions: simplifies plan to top 2 actions\n- calendar_overload: reduces action count, adds recovery block\n- urgent_message: adds one draft_reply action, keeps plan light\n- manual: general replan\n- recovery_mode: recovery-first plan\n- stuck_tasks: includes at most one stuck task action\n\nPreserves completed micro-actions.", "operationId": "trigger_replan_copilot_replan_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReplanRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReplanResult"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/context/tasks/analysis": {"get": {"tags": ["Task Aggregator"], "summary": "Analyze tasks for patterns and stuck tasks", "description": "Pulls open tasks from the planner, identifies 'stuck' tasks (open > 7 days),\nand uses the LLM to detect underlying patterns and suggest actions.", "operationId": "analyze_tasks_context_tasks_analysis_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskAggregatorResponse"}}}}}}}, "/context/energy/trend": {"get": {"tags": ["Energy Tracker"], "summary": "Get energy trend and suggestions", "description": "Analyzes the last 7 days of energy logs and provides a trend (increasing/decreasing/stable)\nalong with actionable suggestions.", "operationId": "get_energy_trend_context_energy_trend_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EnergyTrendResponse"}}}}}}}, "/copilot/detect-overload": {"post": {"tags": ["Overload Detector"], "summary": "Detect pattern triggers for overload", "description": "Monitors recent energy levels and failed/deferred tasks. \nAutomatically switches today's plan to 'recovery' mode if an overload pattern is detected.", "operationId": "check_overload_copilot_detect_overload_post", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OverloadDetectorResponse"}}}}}}}, "/micro-actions/next-action": {"get": {"tags": ["Next Action Prompter"], "summary": "Get the single next best micro-action", "description": "Cuts through the noise and returns only the single next step the user should take right now.\nFilters out high-energy tasks if the user's current energy is low.", "operationId": "next_action_micro_actions_next_action_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NextActionResponse"}}}}}}}, "/copilot/activate-recovery": {"post": {"tags": ["Recovery Mode"], "summary": "Manually trigger recovery mode", "description": "Snoozes all high-energy tasks and immediately injects \nlow-friction, self-care tasks into the current plan.", "operationId": "activate_recovery_copilot_activate_recovery_post", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecoveryModeResponse"}}}}}}}}, "components": {"schemas": {"EnergyTrendResponse": {"properties": {"current_level": {"type": "integer", "title": "Current Level"}, "trend": {"type": "string", "title": "Trend"}, "suggestions": {"items": {"type": "string"}, "type": "array", "title": "Suggestions"}}, "type": "object", "required": ["current_level", "trend", "suggestions"], "title": "EnergyTrendResponse"}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "MakeSmallerRequest": {"properties": {"current_energy": {"anyOf": [{"type": "integer", "maximum": 100.0, "minimum": 0.0}, {"type": "null"}], "title": "Current Energy"}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason"}}, "type": "object", "title": "MakeSmallerRequest"}, "MakeSmallerResponse": {"properties": {"original_micro_action": {"$ref": "#/components/schemas/MicroAction"}, "smaller_actions": {"items": {"$ref": "#/components/schemas/MicroAction"}, "type": "array", "title": "Smaller Actions"}}, "type": "object", "required": ["original_micro_action", "smaller_actions"], "title": "MakeSmallerResponse"}, "MicroAction": {"properties": {"id": {"type": "string", "title": "Id"}, "user_id": {"type": "string", "title": "User Id"}, "task_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Task Id"}, "plan_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Plan Id"}, "parent_micro_action_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Parent Micro Action Id"}, "title": {"type": "string", "title": "Title"}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Description"}, "duration_minutes": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Duration Minutes"}, "energy_cost": {"anyOf": [{"type": "string", "enum": ["low", "medium", "high"]}, {"type": "null"}], "title": "Energy Cost"}, "sensory_cost": {"anyOf": [{"type": "string", "enum": ["low", "medium", "high"]}, {"type": "null"}], "title": "Sensory Cost"}, "friction_level": {"anyOf": [{"type": "string", "enum": ["low", "medium", "high"]}, {"type": "null"}], "title": "Friction Level"}, "status": {"type": "string", "enum": ["open", "done", "snoozed", "skipped", "deferred"], "titl